<!-- TreatAsLocalProperty: a global TargetFramework (CI restores/builds the slnx with -p:TargetFramework=net10.0) must not retarget this net8.0 package. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="TargetFramework">

  <Import Project="..\..\PackageVersion.props" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Pernix.OutboxRelay.Client</PackageId>
    <Description>Engine-neutral producer types for the Pernix Outbox Relay: outbox message, headers, table name and column names.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pernix.OutboxRelay.Client.Unit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RouteRules.cs" Link="RouteRules.cs" />
  </ItemGroup>

</Project>
