<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- platform-cicd generates its own nuget.config without packageSourceMapping, so NU1507 must stay a warning. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1507</WarningsNotAsErrors>
    <IsPackable>false</IsPackable>

    <Company>Pernix</Company>
    <Product>OutboxRelay</Product>
  </PropertyGroup>
</Project>
