<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Pernix.OutboxRelay.Benchmarks</RootNamespace>
    <!-- In no release unit, so CI never builds or runs it. -->
    <IsTestProject>false</IsTestProject>
    <!-- Gen0/1/2 counts are only readable under workstation non-concurrent GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pernix.OutboxRelay.Core\Pernix.OutboxRelay.Core.csproj" />
    <ProjectReference Include="..\..\src\Pernix.OutboxRelay.Destination.Http\Pernix.OutboxRelay.Destination.Http.csproj" />
    <ProjectReference Include="..\..\src\Pernix.OutboxRelay.Destination.Kafka\Pernix.OutboxRelay.Destination.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Pernix.OutboxRelay.Outbox.PostgreSql\Pernix.OutboxRelay.Outbox.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\sql\postgresql\*.sql" Link="Sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
